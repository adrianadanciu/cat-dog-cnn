#keeps the web server running in the background, even after the terminal is closed
[Unit]
Description=Cat vs Dog web server
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/cat-dog-cnn
#the file with DATABASE_URL, the same one used with export
EnvironmentFile=/home/ubuntu/catdog.env
ExecStart=/home/ubuntu/cat-dog-cnn/venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000
#if the server stops because of an error, it is started again after 5 seconds
Restart=always
RestartSec=5
[Install]
#starts the server every time the machine is turned on
WantedBy=multi-user.target
